# Thin-API Lambda Function URL (AuthType=NONE).
# The browser calls this directly with a plain fetch (no AWS credentials) and
# asserts the active persona via the X-Mahalo-Persona header. Supplied at deploy
# time; never hardcoded in source.
# e.g. https://<function-id>.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_API_URL=
