# Thin-API Lambda Function URL (AuthType=AWS_IAM).
# e.g. https://<function-id>.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_API_URL=

# AWS region used by the in-browser SigV4 signer and the Cognito provider.
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito (unauthenticated) identity pool the browser exchanges for temporary
# IAM credentials. Public identifier; no secret value.
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
